<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Panel Admin</title>
  <link rel="stylesheet" href="css/admin.css" />
</head>
<body>
  <!-- Menú hamburguesa -->
  <div class="hamburger" onclick="toggleSidebar()">☰</div>

  <!-- Sidebar -->
  <div class="sidebar" id="sidebar">
    <button class="close-btn" onclick="toggleSidebar()">←</button>
    <button onclick="verPerfil()">👤 Ver perfil</button>
    <button onclick="cerrarSesion()">🚪 Cerrar sesión</button>
  </div>

  <!-- Panel central -->
  <div class="main">
    <h1>Bienvenido <span id="username">Admin</span></h1>
    <p>Para continuar con la gestión de su evento debe completar los siguientes pasos:</p>

<div class="actions">
  <button id="btnImportar" class="btn activo">📥 Importar invitados</button>
  <button id="btnFormulario" class="btn bloqueado" disabled>📝 Generar formulario de inscripción</button>
  <button id="btnEnviar" class="btn bloqueado" disabled>📤 Enviar formulario</button>
</div>


    <!-- Aquí se mostrará la tabla -->
    <div id="tablaInvitados"></div>
  </div>

  <!-- Modal emergente -->
  <div id="modal" class="modal">
    <div class="modal-content">
      <span class="close-modal" id="closeModal">×</span>
      <h2>Importar invitados</h2>
      <p>Sube tu archivo CSV/XLSX:</p>
      <input type="file" id="fileInput" accept=".csv" />
      <br><br>
      <button id="btnCargarArchivo">Cargar archivo</button>
    </div>
  </div>

  <script src="js/admin.js"></script>
</body>
</html>
